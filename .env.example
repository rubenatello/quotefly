# QuoteFly API environment template
# Copy to .env for local development. Do not commit real credentials.

# Runtime
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quotefly?schema=public"
# Production runtime must use the non-owner quotefly_runtime role. Prisma
# migrations use the separate owner/direct connection.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quotefly?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Optional for one API replica; required before horizontally scaling the API.
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REQUIRE_SHARED_STORE=false

# Public app/API URLs
# Production values must not use localhost.
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Transactional account email (Resend)
# Verify your sending domain before enabling password recovery in production.
RESEND_API_KEY=""
PASSWORD_RESET_EMAIL_FROM="QuoteFly <support@quotefly.us>"
SUPPORT_EMAIL="support@quotefly.us"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Browser session cookie
# Keep SameSite=lax when the web and API are same-site, for example app.quotefly.us and api.quotefly.us.
SESSION_COOKIE_NAME="qf_session"
SESSION_COOKIE_DOMAIN=""
SESSION_COOKIE_SAME_SITE="lax"

# Admin access
# Comma-separated emails that should receive superuser access.
SUPERUSER_EMAILS="owner@example.com"

# OpenAI
# Leave blank to use parser/fallback behavior where supported.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_ASSISTANT_TIMEOUT_MS="12000"
OPENAI_COST_INPUT_PER_1M_USD=0.15
OPENAI_COST_OUTPUT_PER_1M_USD=0.60
OPENAI_EMBEDDING_COST_PER_1M_USD=0.02
# Production defaults to off. Use shadow_allowlist before allowlist with
# explicit tenant ids; use all only after release, privacy, and operations gates.
AI_RAG_ROLLOUT_MODE="off"
AI_RAG_TENANT_ALLOWLIST=""
ENABLE_AI_INDEX_WORKER=false
AI_INDEX_INLINE_REFRESH=true

# Daily run-once in-app notification soft-archive worker. Dry-run is the
# default; scheduled apply requires this gate plus the --apply argument.
ENABLE_NOTIFICATION_RETENTION_WORKER=false
NOTIFICATION_RETENTION_READ_DAYS=90
NOTIFICATION_RETENTION_UNREAD_DAYS=365

# Stripe
# Use test-mode values locally and live-mode values only in production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_COUPON_ID_BASIC_FIRST_MONTH_HALF_OFF=""
STRIPE_PRICE_ID_PROFESSIONAL=""
STRIPE_PRICE_ID_ENTERPRISE=""

# QuickBooks Online
# Use sandbox locally unless intentionally testing production Intuit apps.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="sandbox"
# Production-mode sandbox testing is allowed only on these explicitly approved
# comma-separated bare HTTPS staging origins. Never list QuoteFly production.
QUICKBOOKS_SANDBOX_STAGING_ORIGINS=""
# Keep provider connect, invoice push, and refresh workflows disabled until their
# production controls and reconciliation evidence have been explicitly approved.
QUICKBOOKS_PROVIDER_WORKFLOWS_ENABLED=false
QUICKBOOKS_HOSTED_PAYMENTS_ENABLED=false
QUICKBOOKS_RECONCILIATION_WORKER_ENABLED=false
QUICKBOOKS_CDC_WORKER_ENABLED=false
QUICKBOOKS_PROVIDER_TIMEOUT_MS=10000
QUICKBOOKS_PROVIDER_READ_RETRIES=2
QUICKBOOKS_REDIRECT_URI="http://localhost:4000/v1/integrations/quickbooks/callback"
QUICKBOOKS_WEBHOOK_VERIFIER=""
# Generate independently from JWT_SECRET. During rotation, move the old value to PREVIOUS until tokens refresh.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=""
QUICKBOOKS_TOKEN_ENCRYPTION_KEY_PREVIOUS=""

# Twilio SMS
ENABLE_TWILIO_SMS=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_AUTH_TOKEN=""

# Local verification tuning
AI_EVAL_PASS_SCORE=92

# Optional local integration-test database.
# The test runner refuses to clean a database whose name does not include "test".
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quotefly_test?schema=public"
