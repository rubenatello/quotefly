generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Timestamp policy:
/// - All DateTime fields are stored in UTC via timestamptz.
/// - `deletedAtUtc` indicates soft-deleted records when present.

enum ServiceCategory {
  HVAC
  PLUMBING
  FLOORING
  ROOFING
  GARDENING
  CONSTRUCTION
}

enum QuoteStatus {
  DRAFT
  READY_FOR_REVIEW
  SENT_TO_CUSTOMER
  ACCEPTED
  REJECTED
}

enum QuoteJobStatus {
  NOT_STARTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum JobAppointmentStatus {
  SCHEDULED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELED
}

enum JobEventType {
  CREATED
  UPDATED
  ASSIGNED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELED
  NOTE_ADDED
  NOTE_DELETED
  CANCELED
  ARCHIVED
  DELETED
}

enum NotificationKind {
  BOOKED
  RESCHEDULED
  DISPATCHED
  ARRIVED
  COMPLETED
  CANCELED
}

enum NotificationDeliveryStatus {
  AVAILABLE
  DELIVERED
}

enum AfterSaleFollowUpStatus {
  NOT_READY
  DUE
  COMPLETED
}

enum ActivityTaskType {
  FOLLOW_UP
  PREPARE_QUOTE
  SEND_QUOTE
  CHECK_IN
  CUSTOM
}

enum ActivityTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ActivityTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityTaskEventType {
  CREATED
  UPDATED
  COMPLETED
  REOPENED
  CANCELED
  DELETED
}

enum ActivityActorKind {
  USER
  SYSTEM
}

enum ActivityTaskOrigin {
  MANUAL
  AUTOMATED_CUSTOMER_FOLLOW_UP
}

enum FollowUpOutcome {
  CONTACTED
  NO_RESPONSE
  SKIPPED
}

enum CustomerFollowUpSequenceStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum SmsMessageDirection {
  INBOUND
  OUTBOUND
}

enum QuoteDecisionStatus {
  AWAITING_APPROVAL
  APPROVED
  REVISION_REQUESTED
}

enum QuoteRevisionEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  LINE_ITEM_CHANGED
  DECISION
}

enum LeadFollowUpStatus {
  NEEDS_FOLLOW_UP
  FOLLOWED_UP
  WON
  LOST
}

enum CustomerLostReason {
  PRICE
  NO_RESPONSE
  COMPETITOR
  TIMING
  NOT_A_FIT
  CUSTOMER_CANCELED
  OTHER
}

enum QuoteOutboundChannel {
  EMAIL_APP
  SMS_APP
  COPY
  NATIVE_SHARE
}

enum AiUsageEventType {
  DRAFT
  REVISE
  BUSINESS_INSIGHT
  INDEXING
  ACCOUNTING
}

enum AiUsageReservationKind {
  OPERATION
  PROVIDER_CALL
}

enum AiUsageReservationState {
  RESERVED
  STARTED
  SETTLED
  VOIDED
  AMBIGUOUS_CHARGED
  EXPIRED_CHARGED
  ACCOUNTING_INCIDENT
}

enum AiPurpose {
  QUOTE_DRAFT
  QUOTE_REVISION
  BUSINESS_INSIGHT
}

enum DataClassification {
  C0_PUBLIC
  C1_BUSINESS_INTERNAL
  C2_CUSTOMER_CONFIDENTIAL
  C3_FINANCIAL_CONFIDENTIAL
  C4_RESTRICTED
}

enum AiRetrievalAuditStatus {
  SUCCEEDED
  DENIED
  FAILED
}

enum AiRetrievalDocumentStatus {
  ACTIVE
  DELETED
}

enum AiIndexJobOperation {
  UPSERT
  DELETE
}

enum AiIndexJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  DEAD
}

enum AiAssistantFeedbackRating {
  UP
  DOWN
}

enum DataGovernanceValidationStatus {
  PASSED
  FAILED
}

enum QuoteLineSectionType {
  INCLUDED
  ALTERNATE
}

enum QuoteLinePriceProvenance {
  MANUAL
  TENANT_PRESET
  AI_REVIEWED
  REVISION_RESTORE
}

enum PresetCategory {
  LABOR
  MATERIAL
  FEE
  SERVICE
}

enum PresetUnitType {
  FLAT
  SQ_FT
  HOUR
  EACH
}

enum QuickBooksConnectionStatus {
  CONNECTED
  NEEDS_REAUTH
  ERROR
  REVOCATION_PENDING
  DISCONNECTED
}

enum QuickBooksOrphanCredentialRevocationStatus {
  PENDING
  PROCESSING
  REVOKED
  DEAD
}

enum QuickBooksInvoiceSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum InvoicePaymentStatus {
  PENDING
  PARTIALLY_PAID
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

enum InvoicePaymentProvider {
  MANUAL
  STRIPE
  SQUARE
  QUICKBOOKS
  OTHER
}

enum InvoiceEventType {
  CREATED
  CREATE_REPLAYED
  UPDATED
  SENT
  PAYMENT_RECORDED
  PAYMENT_UPDATED
  VOIDED
  DELETED
  PROVIDER_SYNC_STARTED
  PROVIDER_SYNC_SUCCEEDED
  PROVIDER_SYNC_FAILED
  PROVIDER_RECONCILIATION_REQUIRED
  PROVIDER_RECONCILED
}

enum QuickBooksInvoiceOperationStatus {
  PROCESSING
  RECONCILING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
}

enum QuickBooksWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

model TenantBranding {
  id                      String    @id @default(cuid())
  tenantId                String    @unique
  logoUrl                 String?
  logoPosition            String    @default("left")
  hideQuoteFlyAttribution Boolean   @default(false)
  primaryColor            String    @default("#5B85AA")
  templateId              String    @default("modern")
  businessEmail           String?
  businessPhone           String?
  quoteMessageTemplate    String?   @db.Text
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  componentColors         Json?
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
  deletedAtUtc            DateTime? @db.Timestamptz(3)
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantBrandAsset {
  id         String   @id @default(cuid())
  tenantId   String
  sha256     String   @db.VarChar(64)
  mimeType   String   @db.VarChar(32)
  data       Bytes
  byteLength Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sha256])
  @@index([tenantId, createdAt])
}

model Tenant {
  id                                    String                                 @id @default(cuid())
  name                                  String
  slug                                  String                                 @unique
  timezone                              String                                 @default("UTC")
  defaultCustomerLocale                 String                                 @default("en-US") @db.VarChar(5)
  primaryTrade                          ServiceCategory?
  onboardingCompletedAtUtc              DateTime?                              @db.Timestamptz(3)
  subscriptionStatus                    String                                 @default("inactive")
  subscriptionPlanCode                  String?
  trialStartsAtUtc                      DateTime?                              @db.Timestamptz(3)
  trialEndsAtUtc                        DateTime?                              @db.Timestamptz(3)
  subscriptionCurrentPeriodStartUtc     DateTime?                              @db.Timestamptz(3)
  subscriptionCurrentPeriodEndUtc       DateTime?                              @db.Timestamptz(3)
  createdAt                             DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt                             DateTime                               @updatedAt @db.Timestamptz(3)
  deletedAtUtc                          DateTime?                              @db.Timestamptz(3)
  phoneNumber                           TenantPhoneNumber?
  users                                 TenantUser[]
  customers                             Customer[]
  pricingProfiles                       PricingProfile[]
  quoteTemplates                        QuoteTemplate[]
  quotes                                Quote[]
  tenantSequences                       TenantSequence[]
  jobs                                  Job[]
  jobAppointments                       JobAppointment[]
  jobNotes                              JobNote[]
  jobEvents                             JobEvent[]
  notifications                         NotificationOutbox[]
  invoices                              Invoice[]
  invoiceLineItems                      InvoiceLineItem[]
  invoicePayments                       InvoicePayment[]
  invoiceEvents                         InvoiceEvent[]
  quickBooksInvoiceOperations           QuickBooksInvoiceOperation[]
  quickBooksOAuthStates                 QuickBooksOAuthState[]
  quickBooksOrphanCredentialRevocations QuickBooksOrphanCredentialRevocation[]
  quickBooksRealmBindings               QuickBooksRealmBinding[]
  quickBooksCdcCursors                  QuickBooksCdcCursor[]
  quickBooksConnectionEvents            QuickBooksConnectionEvent[]
  activityTasks                         ActivityTask[]
  activityTaskEvents                    ActivityTaskEvent[]
  followUpTemplates                     FollowUpTemplate[]
  followUpTemplateSteps                 FollowUpTemplateStep[]
  customerFollowUpSequences             CustomerFollowUpSequence[]
  customerActivityEvents                CustomerActivityEvent[]
  aiUsageEvents                         AiUsageEvent[]
  aiUsagePeriods                        AiUsagePeriod[]
  aiUsageReservations                   AiUsageReservation[]
  aiRetrievalAuditEvents                AiRetrievalAuditEvent[]
  aiRetrievalDocuments                  AiRetrievalDocument[]
  aiRetrievalChunks                     AiRetrievalChunk[]
  aiIndexJobs                           AiIndexJob[]
  aiAssistantFeedback                   AiAssistantFeedback[]
  quoteDecisionSessions                 QuoteDecisionSession[]
  smsMessages                           SmsMessage[]
  stripeCustomerId                      String?                                @unique
  stripeSubscriptionId                  String?                                @unique
  stripeCheckoutSessionId               String?                                @unique
  stripeCheckoutSessionExpiresAtUtc     DateTime?                              @db.Timestamptz(3)
  stripeCheckoutAttemptId               String?
  stripeCheckoutAttemptExpiresAtUtc     DateTime?                              @db.Timestamptz(3)
  billingStateEventCreatedAtUtc         DateTime?                              @db.Timestamptz(3)
  billingStateEventId                   String?
  branding                              TenantBranding?
  brandAssets                           TenantBrandAsset[]
  quoteLineItems                        QuoteLineItem[]
  quoteRevisions                        QuoteRevision[]
  quoteOutboundEvents                   QuoteOutboundEvent[]
  billingWebhookEvents                  BillingWebhookEvent[]
  workPresets                           WorkPreset[]
  quickBooksConnection                  QuickBooksConnection?
  quickBooksCustomerMaps                QuickBooksCustomerMap[]
  quickBooksItemMaps                    QuickBooksItemMap[]
  quickBooksInvoiceSyncs                QuickBooksInvoiceSync[]
  quickBooksWebhookEvents               QuickBooksWebhookEvent[]

  @@index([createdAt])
  @@index([primaryTrade])
  @@index([deletedAtUtc])
  @@index([stripeCheckoutAttemptExpiresAtUtc], map: "Tenant_checkout_attempt_expiry_idx")
  @@index([stripeCheckoutSessionExpiresAtUtc], map: "Tenant_checkout_session_expiry_idx")
}

model TenantSequence {
  id        String   @id @default(cuid())
  tenantId  String
  key       String   @db.VarChar(64)
  nextValue Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([tenantId, key], map: "TenantSequence_tenant_key_idx")
}

model User {
  id                           String                        @id @default(cuid())
  email                        String                        @unique
  fullName                     String
  preferredLocale              String                        @default("en-US") @db.VarChar(5)
  passwordHash                 String
  authVersion                  Int                           @default(0)
  legalAcceptedAtUtc           DateTime?                     @db.Timestamptz(3)
  termsVersion                 String?
  privacyPolicyVersion         String?
  createdAt                    DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                      @updatedAt @db.Timestamptz(3)
  deletedAtUtc                 DateTime?                     @db.Timestamptz(3)
  tenantLink                   TenantUser[]
  aiUsageEvents                AiUsageEvent[]
  aiRetrievalAuditEvents       AiRetrievalAuditEvent[]
  aiAssistantFeedback          AiAssistantFeedback[]
  dataGovernanceValidationRuns DataGovernanceValidationRun[]
  superuserAuditEvents         SuperuserAuditEvent[]
  passwordResetTokens          PasswordResetToken[]

  @@index([deletedAtUtc])
}

model PasswordResetToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(64)
  expiresAtUtc DateTime  @db.Timestamptz(3)
  usedAtUtc    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAtUtc])
}

model QuoteDraftRecovery {
  id           String     @id @default(cuid())
  tenantId     String
  tenantUserId String
  scope        String     @db.VarChar(191)
  payload      Json
  savedAtUtc   DateTime   @db.Timestamptz(3)
  expiresAtUtc DateTime   @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  tenantUser   TenantUser @relation(fields: [tenantUserId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, tenantUserId, scope])
  @@index([tenantId, tenantUserId, expiresAtUtc])
  @@index([expiresAtUtc])
}

model TenantUser {
  id                             String                       @id @default(cuid())
  tenantId                       String
  userId                         String
  role                           String                       @default("owner")
  createdAt                      DateTime                     @default(now()) @db.Timestamptz(3)
  deletedAtUtc                   DateTime?                    @db.Timestamptz(3)
  tenant                         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCustomers              Customer[]                   @relation("CustomerAssignee")
  assignedQuotes                 Quote[]                      @relation("QuoteAssignee")
  assignedJobs                   Job[]                        @relation("JobAssignee")
  assignedJobAppointments        JobAppointment[]             @relation("JobAppointmentAssignee")
  createdJobAppointments         JobAppointment[]             @relation("JobAppointmentCreator")
  jobNotes                       JobNote[]                    @relation("JobNoteCreator")
  jobEvents                      JobEvent[]
  receivedNotifications          NotificationOutbox[]         @relation("NotificationRecipient")
  actedNotifications             NotificationOutbox[]         @relation("NotificationActor")
  invoiceEvents                  InvoiceEvent[]
  quickBooksInvoiceOperations    QuickBooksInvoiceOperation[]
  reviewedQuickBooksCustomerMaps QuickBooksCustomerMap[]      @relation("QuickBooksCustomerMapReviewer")
  reviewedQuickBooksItemMaps     QuickBooksItemMap[]          @relation("QuickBooksItemMapReviewer")
  confirmedQuickBooksSetups      QuickBooksConnection[]       @relation("QuickBooksSetupConfirmer")
  quickBooksConnectionEvents     QuickBooksConnectionEvent[]  @relation("QuickBooksConnectionEventActor")
  quickBooksOAuthStates          QuickBooksOAuthState[]       @relation("QuickBooksOAuthStateActor")
  assignedActivityTasks          ActivityTask[]               @relation("ActivityTaskAssignee")
  createdActivityTasks           ActivityTask[]               @relation("ActivityTaskCreator")
  completedActivityTasks         ActivityTask[]               @relation("ActivityTaskCompleter")
  activityTaskEvents             ActivityTaskEvent[]
  markedLostCustomers            Customer[]                   @relation("CustomerLostActor")
  quoteDrafts                    QuoteDraftRecovery[]
  aiUsageReservations            AiUsageReservation[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([userId])
  @@index([tenantId, deletedAtUtc])
  @@index([tenantId, userId, deletedAtUtc])
}

model TenantPhoneNumber {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  provider     String    @default("twilio")
  e164Number   String    @unique
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAtUtc DateTime? @db.Timestamptz(3)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAtUtc])
}

model Customer {
  id                         String                     @id @default(cuid())
  tenantId                   String
  fullName                   String
  email                      String?
  phone                      String
  phoneDigits                String?
  notes                      String?
  preferredLocale            String?                    @db.VarChar(5)
  followUpStatus             LeadFollowUpStatus         @default(NEEDS_FOLLOW_UP)
  followUpUpdatedAtUtc       DateTime?                  @db.Timestamptz(3)
  lastFollowUpAttemptAtUtc   DateTime?                  @db.Timestamptz(3)
  lastSuccessfulContactAtUtc DateTime?                  @db.Timestamptz(3)
  lifecycleVersion           Int                        @default(1)
  lostReason                 CustomerLostReason?
  lostReasonNotes            String?                    @db.VarChar(1000)
  lostAtUtc                  DateTime?                  @db.Timestamptz(3)
  lostByTenantUserId         String?
  reopenedAtUtc              DateTime?                  @db.Timestamptz(3)
  assignedTenantUserId       String?
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
  archivedAtUtc              DateTime?                  @db.Timestamptz(3)
  deletedAtUtc               DateTime?                  @db.Timestamptz(3)
  tenant                     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTenantUser         TenantUser?                @relation("CustomerAssignee", fields: [assignedTenantUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lostByTenantUser           TenantUser?                @relation("CustomerLostActor", fields: [lostByTenantUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  quotes                     Quote[]
  jobs                       Job[]
  invoices                   Invoice[]
  activityTasks              ActivityTask[]
  followUpSequences          CustomerFollowUpSequence[]
  activityEvents             CustomerActivityEvent[]
  revisions                  QuoteRevision[]
  quoteOutboundEvents        QuoteOutboundEvent[]
  aiUsageEvents              AiUsageEvent[]
  quickBooksCustomerMaps     QuickBooksCustomerMap[]

  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phoneDigits])
  @@index([tenantId, archivedAtUtc, deletedAtUtc])
  @@index([tenantId, phoneDigits, archivedAtUtc, deletedAtUtc])
  @@index([tenantId, deletedAtUtc])
  @@index([tenantId, assignedTenantUserId, archivedAtUtc, deletedAtUtc], map: "Customer_tenantId_assignee_lifecycle_idx")
  @@index([tenantId, followUpStatus, lostAtUtc(sort: Desc)], map: "Customer_tenantId_status_lostAt_idx")
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, archivedAtUtc, deletedAtUtc, updatedAt(sort: Desc), id(sort: Desc)], map: "Customer_tenantId_archived_deleted_updated_id_idx")
}

model FollowUpTemplate {
  id           String                     @id @default(cuid())
  tenantId     String
  version      Int
  enabled      Boolean                    @default(true)
  isDefault    Boolean                    @default(true)
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(3)
  retiredAtUtc DateTime?                  @db.Timestamptz(3)
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps        FollowUpTemplateStep[]
  sequences    CustomerFollowUpSequence[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, version])
  @@unique([tenantId, version])
  @@index([tenantId, isDefault, enabled, retiredAtUtc], map: "FollowUpTemplate_default_idx")
}

model FollowUpTemplateStep {
  id           String               @id @default(cuid())
  tenantId     String
  templateId   String
  stepNumber   Int
  delayMinutes Int
  title        String               @db.VarChar(160)
  notes        String?              @db.VarChar(2000)
  priority     ActivityTaskPriority @default(NORMAL)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template     FollowUpTemplate     @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([templateId, stepNumber])
  @@unique([id, tenantId])
  @@index([tenantId, templateId, stepNumber], map: "FollowUpTemplateStep_template_idx")
}

model CustomerFollowUpSequence {
  id                 String                         @id @default(cuid())
  tenantId           String
  customerId         String
  templateId         String
  templateVersion    Int
  status             CustomerFollowUpSequenceStatus @default(ACTIVE)
  startedAtUtc       DateTime                       @db.Timestamptz(3)
  completedAtUtc     DateTime?                      @db.Timestamptz(3)
  canceledAtUtc      DateTime?                      @db.Timestamptz(3)
  cancellationReason String?                        @db.VarChar(64)
  createdAt          DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @db.Timestamptz(3)
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer                       @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  template           FollowUpTemplate               @relation(fields: [templateId, tenantId, templateVersion], references: [id, tenantId, version], onDelete: Restrict)
  tasks              ActivityTask[]

  @@unique([id, tenantId])
  @@index([tenantId, customerId, status], map: "CustomerFollowUpSequence_customer_status_idx")
  @@index([tenantId, status, startedAtUtc], map: "CustomerFollowUpSequence_status_started_idx")
}

model PricingProfile {
  id             String          @id @default(cuid())
  tenantId       String
  serviceType    ServiceCategory
  laborRate      Decimal         @db.Decimal(10, 2)
  materialMarkup Decimal         @db.Decimal(5, 2)
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  deletedAtUtc   DateTime?       @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceType])
  @@index([tenantId, deletedAtUtc])
}

model QuoteTemplate {
  id           String          @id @default(cuid())
  tenantId     String
  name         String
  serviceType  ServiceCategory
  description  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  deletedAtUtc DateTime?       @db.Timestamptz(3)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, serviceType])
  @@index([tenantId, deletedAtUtc])
}

model Quote {
  id                              String                  @id @default(cuid())
  tenantId                        String
  customerId                      String
  assignedTenantUserId            String?
  serviceType                     ServiceCategory
  status                          QuoteStatus             @default(DRAFT)
  jobStatus                       QuoteJobStatus          @default(NOT_STARTED)
  afterSaleFollowUpStatus         AfterSaleFollowUpStatus @default(NOT_READY)
  title                           String
  scopeText                       String
  documentLocale                  String                  @default("en-US") @db.VarChar(5)
  internalCostSubtotal            Decimal                 @db.Decimal(10, 2)
  customerPriceSubtotal           Decimal                 @db.Decimal(10, 2)
  taxAmount                       Decimal                 @db.Decimal(10, 2)
  totalAmount                     Decimal                 @db.Decimal(10, 2)
  aiGeneratedAtUtc                DateTime?               @db.Timestamptz(3)
  aiPromptText                    String?
  aiModel                         String?
  createIdempotencyKeyHash        String?                 @db.VarChar(64)
  createRequestHash               String?                 @db.VarChar(64)
  sentAt                          DateTime?               @db.Timestamptz(3)
  closedAtUtc                     DateTime?               @db.Timestamptz(3)
  jobCompletedAtUtc               DateTime?               @db.Timestamptz(3)
  afterSaleFollowUpDueAtUtc       DateTime?               @db.Timestamptz(3)
  afterSaleFollowUpCompletedAtUtc DateTime?               @db.Timestamptz(3)
  createdAt                       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                @updatedAt @db.Timestamptz(3)
  archivedAtUtc                   DateTime?               @db.Timestamptz(3)
  deletedAtUtc                    DateTime?               @db.Timestamptz(3)
  tenant                          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
