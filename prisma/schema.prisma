model QuickBooksWebhookEvent {
  id                     String                       @id @default(cuid())
  tenantId               String?
  quickBooksConnectionId String?
  webhookEventId         String
  realmId                String
  eventType              String
  entityId               String?
  operation              String?
  providerUpdatedAtUtc   DateTime?                    @db.Timestamptz(3)
  payload                Json
  status                 QuickBooksWebhookEventStatus @default(RECEIVED)
  attemptCount           Int                          @default(0)
  nextAttemptAtUtc       DateTime?                    @db.Timestamptz(3)
  claimTokenHash         String?                      @db.VarChar(64)
  claimExpiresAtUtc      DateTime?                    @db.Timestamptz(3)
  receivedAtUtc          DateTime                     @default(now()) @db.Timestamptz(3)
  processedAtUtc         DateTime?                    @db.Timestamptz(3)
  deadAtUtc              DateTime?                    @db.Timestamptz(3)
  lastError              String?
  tenant                 Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  connection             QuickBooksConnection?        @relation(fields: [quickBooksConnectionId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([webhookEventId, realmId])
  @@index([realmId, receivedAtUtc])
  @@index([tenantId, status, nextAttemptAtUtc, claimExpiresAtUtc, receivedAtUtc, id], map: "QuickBooksWebhookEvent_worker_idx")
  @@index([tenantId, status, processedAtUtc, id], map: "QuickBooksWebhookEvent_processed_retention_idx")
  @@index([tenantId, status, deadAtUtc, id], map: "QuickBooksWebhookEvent_dead_retention_idx")
}

model QuickBooksOAuthState {
  id                     String                @id @default(cuid())
  tenantId               String
  quickBooksConnectionId String?
  userId                 String
  stateHash              String                @unique @db.VarChar(64)
  expiresAtUtc           DateTime              @db.Timestamptz(3)
  consumedAtUtc          DateTime?             @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorTenantUser        TenantUser            @relation("QuickBooksOAuthStateActor", fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  connection             QuickBooksConnection? @relation(fields: [quickBooksConnectionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, expiresAtUtc, consumedAtUtc])
  @@index([tenantId, consumedAtUtc, expiresAtUtc, id], map: "QuickBooksOAuthState_retention_idx")
}

model QuickBooksOrphanCredentialRevocation {
  id                    String                                     @id @default(cuid())
  tenantId              String
  dedupeKeyHash         String                                     @db.VarChar(64)
  refreshTokenEncrypted String?
  status                QuickBooksOrphanCredentialRevocationStatus @default(PENDING)
  attemptCount          Int                                        @default(1)
  nextAttemptAtUtc      DateTime?                                  @db.Timestamptz(3)
  claimTokenHash        String?                                    @db.VarChar(64)
  claimExpiresAtUtc     DateTime?                                  @db.Timestamptz(3)
  lastAttemptAtUtc      DateTime?                                  @db.Timestamptz(3)
  lastErrorCode         String?                                    @db.VarChar(191)
  revokedAtUtc          DateTime?                                  @db.Timestamptz(3)
  deadAtUtc             DateTime?                                  @db.Timestamptz(3)
  createdAt             DateTime                                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                                   @updatedAt @db.Timestamptz(3)
  tenant                Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, dedupeKeyHash])
  @@index([tenantId, status, nextAttemptAtUtc, claimExpiresAtUtc, createdAt, id], map: "QuickBooksOrphanCredentialRevocation_worker_idx")
}

