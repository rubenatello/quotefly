  reviewedByTenantUserId String?
  reviewedAtUtc          DateTime?            @db.Timestamptz(3)
  reviewVersion          Int                  @default(0)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  deletedAtUtc           DateTime?            @db.Timestamptz(3)
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection             QuickBooksConnection @relation(fields: [quickBooksConnectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workPreset             WorkPreset?          @relation(fields: [workPresetId, tenantId], references: [id, tenantId], onDelete: NoAction)
  reviewedByTenantUser   TenantUser?          @relation("QuickBooksItemMapReviewer", fields: [reviewedByTenantUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([quickBooksConnectionId, itemKey])
  @@unique([quickBooksConnectionId, quickBooksItemId])
  @@index([tenantId, deletedAtUtc])
  @@index([tenantId, reviewedByTenantUserId, reviewedAtUtc])
}

model QuickBooksInvoiceSync {
  id                     String                      @id @default(cuid())
  tenantId               String
  quickBooksConnectionId String
  quoteId                String
  quickBooksInvoiceId    String?
  quickBooksDocNumber    String?
  requestId              String?
  status                 QuickBooksInvoiceSyncStatus @default(PENDING)
  payloadSnapshot        Json?
  lastError              String?
  lastAttemptedAtUtc     DateTime?                   @db.Timestamptz(3)
  syncedAtUtc            DateTime?                   @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  deletedAtUtc           DateTime?                   @db.Timestamptz(3)
  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
