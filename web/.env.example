# QuoteFly web environment template
# Copy to web/.env for local frontend development.
# Every VITE_* value is public in the browser bundle.

VITE_API_BASE_URL=https://api.quotefly.us

# Reserved for future Stripe.js/browser usage.
# The current billing flow creates Checkout/Billing Portal sessions through the API.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
